# Local development settings. Never commit your real .env file.
ADMIN_USERNAME=ipagadmin
ADMIN_PASSWORD=replace-this-with-a-long-unique-password
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
PORT=3000
HOST=127.0.0.1

# Supabase: use the connection string from Project Settings > Database.
# Prefer the session pooler connection string if your host's network requires it.
# Keep DATABASE_URL private. Do not put it in browser JavaScript or GitHub.
# PGSSL=disable
